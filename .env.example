# Copy this file to .env and fill in the values. Never commit .env.
# All values below are placeholders for local development only.

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Local infrastructure (used by docker-compose.yml) ---
POSTGRES_USER=leakguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leakguard
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Connection strings used by the API and the worker ---
DATABASE_URL=postgresql://leakguard:change-me@localhost:5432/leakguard
REDIS_URL=redis://:change-me@localhost:6379

# --- Client (Vite dev server) ---
# The dev server proxies /api requests to this origin.
VITE_API_PROXY_TARGET=http://localhost:3000
