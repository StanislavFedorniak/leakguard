{
  "name": "@leakguard/detector",
  "version": "0.1.0",
  "private": true,
  "description": "LeakGuard secret detection engine (runs in Node.js and in the browser)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@leakguard/shared": "0.1.0"
  }
}
